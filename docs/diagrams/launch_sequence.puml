@startuml launch_sequence
title paddock — sandboxed launch sequence (srt backend, v1)

skinparam shadowing false
skinparam sequenceMessageAlign left

legend top
  Participants marked **(planned)** are not built yet, and neither is the
  layer-2 agent config — see SPEC section 7. Everything else exists today.
endlegend

actor User
participant "Herdr" as Herdr
participant "cli.py\n(planned)" as CLI
participant "tui.py\n(chooser, planned)" as TUI
participant "sessions.py\n(registry, planned)" as Sessions
participant "profiles.py" as Profiles
participant "agents.py" as Agents
participant "backends/srt.py" as Backend
participant "synth_config.py\n(planned)" as Synth
participant "herdr_client.py" as Client
participant "srt\n(Seatbelt / bubblewrap)" as Srt

User -> Herdr : press prefix+c
activate Herdr
Herdr -> CLI : run `paddock` in a popup\nenv: HERDR_SOCKET_PATH,\nHERDR_ACTIVE_WORKSPACE_ID,\nHERDR_ACTIVE_PANE_ID
activate CLI
CLI -> TUI : run_chooser(cwd)
activate TUI

TUI -> Sessions : list live sessions
TUI -> User : Local / New sandbox session / Attach to existing?
User --> TUI : New sandbox session

alt Local namespace chosen
  TUI -> Backend : launch_local(cwd)
  Backend -> Client : create_tab(cwd)
  note right : plain tab, no label, no session, no sandbox — flow ends here
else Attach to an existing session chosen
  TUI -> Sessions : look up chosen session
  note right
    msb: exec a shell into the running guest.
    srt: new process under the SAME settings
    file and workdir — shared policy and files,
    separate process tree.
  end note
end

TUI -> Profiles : load_profiles()
activate Profiles
Profiles --> TUI : built-ins + $PADDOCK_CONFIG_DIR/profiles/*.json
deactivate Profiles
TUI -> User : pick a profile (or build a custom one)
User --> TUI : profile

group Questionnaire (skipped when a saved profile is reused)
  TUI -> Agents : load_agents()
  TUI -> User : agent? tools? network? shared dir? skills? MCP servers?
  User --> TUI : answers
  opt user names the profile
    TUI -> Profiles : save_profile(profile)
  end
end

TUI -> Sessions : register session

TUI -> Backend : launch(profile)
deactivate TUI
activate Backend

Backend -> Agents : load_agents()[profile.agent]
activate Agents
Agents --> Backend : AgentSpec (command, api_domains,\nconfig_write_paths)
deactivate Agents
Backend -> Backend : new_run_dir()\n$PADDOCK_STATE_DIR/runs/<timestamp>-<rand>/
Backend -> Backend : workdir_for(profile, run_dir)\nshared_dir, else run_dir/work (isolated)
Backend -> Backend : build_shim_dir(run_dir, tools)\nsymlink one binary per tool via shutil.which;\ntool names must be bare filenames;\nreturns the ones it could not shim
Backend -> Backend : build_settings(profile, agent, workdir)\n-> run_dir/srt-settings.json\nnetwork.allowedDomains (allowlist-only) + deniedDomains\nfilesystem.allowWrite (workdir, /tmp, /private/tmp,\n/dev/null, config_write_paths) — not the run dir\nfilesystem.allowRead (the agent's own credentials)\nfilesystem.denyRead = denyWrite (~/.ssh, ~/.aws, ...)\nevery configured path expanded here
Backend -> Agents : layer-2 agent config (planned)
Backend -> Synth : build synthetic config dir (planned)\n-> CLAUDE_CONFIG_DIR via `tab create --env`
Backend -> Backend : pane_command(...)\nfind_srt(): `srt`, else `npx -y @anthropic-ai/sandbox-runtime`\n(composed before any tab exists, so a missing srt\nfails with no empty pane left behind)

Backend -> Client : create_tab(workdir, label="sbx:<profile>")
activate Client
Client -> Herdr : herdr tab create [--workspace <id>]\n--cwd <workdir> --label sbx:<profile> --focus
Herdr --> Client : {"result":{"root_pane":{"pane_id":"wA:p2"}}}
Client --> Backend : "wA:p2"
Backend -> Client : run_in_pane("wA:p2", command)
Client -> Herdr : herdr pane run wA:p2\n`srt --settings <file> -c 'env -i <kept vars>`\n`PATH=<shim>:/usr/bin:/bin <agent>'`
deactivate Client
Backend --> CLI : pane_id
deactivate Backend
CLI -> Sessions : record pane wA:p2 as attached
CLI --> Herdr : exit (popup closes)
deactivate CLI

Herdr -> Srt : start sandboxed process tree in pane wA:p2
deactivate Herdr
activate Srt
Srt -> Srt : enforce write paths, read denials,\ndomain allowlist (kernel-level)
Srt --> User : agent running in the sandboxed pane
deactivate Srt

note over Backend, Srt
  Tab creation and command execution are separate calls:
  the pane exists with the right cwd and label before any
  sandboxed process starts, so a launch failure leaves a
  visible, usable pane rather than a vanished window.
end note

@enduml
